# Puerto del servidor
PORT=4000
NODE_ENV=development

# Base de datos MySQL
DATABASE_URL="mysql://root:password@localhost:3306/baxio_db"

# Autenticación JWT
JWT_SECRET="CHANGE_ME_generate_a_random_secret_for_this_installation"
JWT_EXPIRES_IN="7d"

# CORS
FRONTEND_URL="http://localhost:3000"

# Producción: ruta absoluta a un volumen persistente; por ejemplo /var/lib/baxio/uploads
# UPLOADS_DIR="/var/lib/baxio/uploads"
# En producción FRONTEND_URL solo admite orígenes HTTPS, separados por comas.
# Usa un usuario MySQL propio (no root) y un secreto aleatorio de al menos 48 caracteres.

# Rate limiting: single backend process, per socket IP, 60-second windows.
API_RATE_LIMIT=240
AUTH_RATE_LIMIT=15
# DATABASE_URL supports connection_limit=10&pool_timeout=10 (finite pool defaults).

# OTP / 2FA: generate an independent random 32-byte hex key and keep a secure backup.
MFA_ENCRYPTION_KEY=
# Local only: preview writes private .mail-preview/*.eml files (never sends email).
# Production MUST use smtp. Never serve the preview folder or commit these files.
MAIL_MODE=preview
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

# SMS stays disabled until a provider is configured. No credentials are needed for email recovery.
SMS_MODE=disabled
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# preview is only for isolated local tests; never use in production or serve .sms-preview.
