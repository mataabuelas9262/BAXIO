# Copia este archivo como deployment/vm.env dentro de la VM.
# Es solo para probar dentro de tu red; no contiene HTTPS ni debe usarse públicamente.
BAXIO_ENV_FILE=./deployment/vm.env
MYSQL_DATABASE=baxio_vm
MYSQL_USER=baxio_app
MYSQL_PASSWORD=CAMBIA_ESTA_CONTRASENA_LARGA
MYSQL_ROOT_PASSWORD=CAMBIA_ESTA_OTRA_CONTRASENA_LARGA
DATABASE_URL=mysql://baxio_app:CAMBIA_ESTA_CONTRASENA_LARGA@db:3306/baxio_vm?connection_limit=10&pool_timeout=10
JWT_SECRET=GENERA_UN_SECRETO_ALEATORIO_DE_128_CARACTERES
MFA_ENCRYPTION_KEY=GENERA_64_CARACTERES_HEXADECIMALES
MAIL_MODE=preview
FRONTEND_URL=http://localhost:8080,http://10.0.2.15:8080
UPLOADS_DIR=/var/lib/baxio/uploads
BACKUP_DIR=/var/lib/baxio/backups
BACKUP_RETENTION_DAYS=7
API_RATE_LIMIT=240
AUTH_RATE_LIMIT=15
SMS_MODE=disabled
