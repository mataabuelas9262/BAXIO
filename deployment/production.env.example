# Copy this to deployment/production.env on the server. Never commit the copied file.
DOMAIN=baxio.example.com
MYSQL_DATABASE=baxio_prod
MYSQL_USER=baxio_app
MYSQL_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_PASSWORD
DATABASE_URL=mysql://baxio_app:REPLACE_URL_ENCODED_PASSWORD@db:3306/baxio_prod?connection_limit=10&pool_timeout=10
JWT_SECRET=REPLACE_WITH_128_HEX_CHARACTERS
MFA_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
MAIL_MODE=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM=BAXIO <your-email@gmail.com>
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=REPLACE_WITH_GMAIL_APP_PASSWORD
FRONTEND_URL=https://baxio.example.com
UPLOADS_DIR=/var/lib/baxio/uploads
BACKUP_DIR=/var/lib/baxio/backups
BACKUP_RETENTION_DAYS=14
API_RATE_LIMIT=240
AUTH_RATE_LIMIT=15
SMS_MODE=disabled
